{
  "name": "@kritzlboard/react",
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable React canvas and composable controls for Kritzlboard.",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "dev": "concurrently -k \"tsc -p tsconfig.build.json --watch\" \"node scripts/copy-css.mjs --watch\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@kritzlboard/core": "workspace:^",
    "lucide-react": "^1.24.0",
    "nanoid": "^5.1.0",
    "perfect-freehand": "^1.2.2"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "jsdom": "^28",
    "typescript": "^6",
    "vitest": "^4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
