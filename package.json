{
  "name": "kritzlboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm build:core && concurrently -k \"pnpm --filter @kritzlboard/core dev\" \"vite dev --port 3000 --strictPort\"",
    "dev:sync": "node --watch server/main.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait --wait-timeout 60",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "build": "pnpm build:core && vite build",
    "start": "node server/main.ts",
    "preview": "vite preview",
    "test": "pnpm build:core && vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "pnpm build:core && tsc --noEmit",
    "build:core": "pnpm --filter @kritzlboard/core build"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@kritzlboard/core": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router": "latest",
    "@tanstack/router-plugin": "latest",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lib0": "^0.2.99",
    "lucide-react": "^1.24.0",
    "nanoid": "^5.1.0",
    "perfect-freehand": "^1.2.2",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "jsdom": "^28",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
