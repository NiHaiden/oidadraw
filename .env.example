# Optional: pnpm dev works without this file. Copy to .env to customize.

# Local sync/auth server port (pnpm dev defaults to 3001).
# PORT=3001

# Set this to skip Docker startup and use an existing Postgres database.
# To use the database from docker-compose.yml, start that database first:
# DATABASE_URL=postgres://kritzlboard:kritzlboard@localhost:5440/kritzlboard

# Optional auth settings:
# BETTER_AUTH_SECRET=replace-with-a-long-random-string
# REQUIRE_AUTH=1
